# ── Polymarket CLOB API ──
POLYMARKET_API_KEY=your_api_key
POLYMARKET_API_SECRET=your_api_secret
POLYMARKET_API_PASSPHRASE=your_passphrase
POLYMARKET_PRIVATE_KEY=your_polygon_private_key
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137

# ── Claude API (agent pays for this from profits) ──
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=1024

# ── Trading Parameters ──
MIN_EDGE=0.08              # 8% minimum mispricing to trade
MAX_POSITION_FRACTION=0.06 # Max 6% of bankroll per position
KELLY_FRACTION=0.5         # Half-Kelly for safety
MIN_BANKROLL=0.0           # Agent dies at $0
SCAN_INTERVAL_SECS=600     # 10 minutes between scans
MAX_OPEN_POSITIONS=20
MIN_LIQUIDITY=1000.0       # Min $1000 liquidity to consider

# ── Data Sources ──
NOAA_API_TOKEN=              # Optional: NOAA Climate Data Online token
ENABLE_WEATHER=true
ENABLE_SPORTS=true
ENABLE_CRYPTO=true

# ── Agent Settings ──
ESTIMATED_COST_PER_CALL=0.01
LOG_LEVEL=info
STATE_FILE=agent_state.json
