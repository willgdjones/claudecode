# TikTok Shop Content Factory - Environment Variables

# =============================================================================
# RESEARCH APIs
# =============================================================================

# Fastmoss API (viral content discovery)
FASTMOSS_API_KEY=your_fastmoss_api_key

# Cruva API (competitor analysis)
CRUVA_API_KEY=your_cruva_api_key

# Manus AI (autonomous research)
MANUS_API_KEY=your_manus_api_key
MANUS_BASE_URL=https://api.manus.ai/v1

# =============================================================================
# CONTENT GENERATION APIs
# =============================================================================

# Nano Banana (image generation)
NANO_BANANA_API_KEY=your_nano_banana_api_key
NANO_BANANA_BASE_URL=https://api.nanobanana.ai/v1

# Kling AI (video generation)
KLING_API_KEY=your_kling_api_key
KLING_BASE_URL=https://api.klingai.com/v1

# Google Veo3 (video generation)
VEO3_API_KEY=your_veo3_api_key
VEO3_PROJECT_ID=your_gcp_project_id

# =============================================================================
# PLATFORM APIs
# =============================================================================

# TikTok
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Instagram (Meta)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key

# =============================================================================
# DATABASE & STORAGE
# =============================================================================

# Database (optional - for state persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/content_factory

# File storage (optional - for generated content)
STORAGE_BUCKET=your-storage-bucket
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1

# =============================================================================
# CONFIGURATION
# =============================================================================

# Default pipeline settings
DEFAULT_VIDEO_TOOL=kling
DEFAULT_SCRIPTS_COUNT=10
DEFAULT_ACCOUNTS_COUNT=5
DEFAULT_POSTS_PER_DAY=3

# Timezone for scheduling
TIMEZONE=America/New_York

# Debug mode
DEBUG=false
